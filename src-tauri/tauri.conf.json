{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "New Eden Foundry",
  "version": "../package.json",
  "identifier": "io.github.savox76.newedenfoundry",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "New Eden Foundry",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 720,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "resources": {
      "binaries/foundry-sidecar-x86_64-pc-windows-msvc.exe": "foundry-sidecar.exe",
      "binaries/foundry-sidecar-lib/": "foundry-sidecar-lib/"
    },
    "shortDescription": "Local EVE industry planning",
    "longDescription": "New Eden Foundry is a local-first desktop workspace for transparent EVE Online industry planning.",
    "copyright": "Copyright © 2026 New Eden Foundry contributors",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "installerHooks": "windows/installer-hooks.nsh"
      }
    }
  }
}
